# Salin file ini jadi `.env` lalu isi nilainya.
# `.env` sudah masuk .gitignore — JANGAN PERNAH di-commit.

# --- Coston2 (testnet, satu-satunya tempat kita mengirim transaksi) ---
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Private key dompet testnet. HANYA untuk testnet.
# Jangan pernah memakai kunci dompet asli di sini. Tanpa awalan 0x.
DEPLOYER_PRIVATE_KEY=

# --- Flare Mainnet: BACA-SAJA, untuk fork lokal ---
# Dipakai Hardhat untuk menyalin kondisi mainnet ke komputer ini saat menjalankan
# tes fork. Tidak ada transaksi yang dikirim ke mainnet, tidak ada gas dibayar.
# Tidak ada private key mainnet di proyek ini, dan memang tidak boleh ada.
MAINNET_RPC_URL=https://flare-api.flare.network/ext/C/rpc

# --- XRPL testnet (diisi di Task 0.2) ---
XRPL_TESTNET_RPC_URL=https://s.altnet.rippletest.net:51234
XRPL_ACCOUNT_SECRET=
